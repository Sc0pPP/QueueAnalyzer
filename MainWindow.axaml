<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QueueAnalyzer.MainWindow"
        Title="Анализ СМО — ПР №14"
        Width="1180" Height="800" MinWidth="900" MinHeight="600"
        Background="#F4F5F7">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E4E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style Selector="TextBlock.groupHeader">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8F98"/>
            <Setter Property="Margin" Value="4,14,0,6"/>
        </Style>
        <Style Selector="RadioButton.typeItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- 1. Меню выбора типа СМО -->
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Файл">
                <MenuItem Header="Рассчитать" Click="OnCalculate" InputGesture="F5"/>
                <MenuItem Header="Очистить" Click="OnReset"/>
                <Separator/>
                <MenuItem Header="Выход" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Тип СМО">
                <MenuItem Header="Одноканальные">
                    <MenuItem Header="1. С отказами" Tag="0" Click="OnMenuType"/>
                    <MenuItem Header="2. С ограниченной очередью" Tag="1" Click="OnMenuType"/>
                    <MenuItem Header="3. С неограниченной очередью" Tag="2" Click="OnMenuType"/>
                </MenuItem>
                <MenuItem Header="Многоканальные">
                    <MenuItem Header="4. С отказами" Tag="3" Click="OnMenuType"/>
                    <MenuItem Header="5. С ограниченной очередью" Tag="4" Click="OnMenuType"/>
                    <MenuItem Header="6. С неограниченной очередью" Tag="5" Click="OnMenuType"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Боковая панель: тот же выбор типа -->
        <Border DockPanel.Dock="Left" Width="300" Background="White"
                BorderBrush="#E2E4E9" BorderThickness="0,1,1,0" Padding="14,6,14,14">
            <StackPanel>
                <TextBlock Text="Тип СМО" FontSize="18" FontWeight="Bold" Margin="4,10,0,0"/>
                <TextBlock Classes="groupHeader" Text="ОДНОКАНАЛЬНЫЕ"/>
                <RadioButton x:Name="Type0" Classes="typeItem" GroupName="qs" Content="1. С отказами" IsChecked="True"/>
                <RadioButton x:Name="Type1" Classes="typeItem" GroupName="qs" Content="2. С ограниченной очередью"/>
                <RadioButton x:Name="Type2" Classes="typeItem" GroupName="qs" Content="3. С неограниченной очередью"/>
                <TextBlock Classes="groupHeader" Text="МНОГОКАНАЛЬНЫЕ"/>
                <RadioButton x:Name="Type3" Classes="typeItem" GroupName="qs" Content="4. С отказами"/>
                <RadioButton x:Name="Type4" Classes="typeItem" GroupName="qs" Content="5. С ограниченной очередью"/>
                <RadioButton x:Name="Type5" Classes="typeItem" GroupName="qs" Content="6. С неограниченной очередью"/>
            </StackPanel>
        </Border>

        <ScrollViewer Padding="20,16">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                <TextBlock x:Name="TypeTitle" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="TypeDescription" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,14"/>

                <!-- 2. Ввод исходных данных -->
                <Grid ColumnDefinitions="*,12,*">
                    <Border Classes="card" Grid.Column="0">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="cardTitle" Text="Входной поток заявок"/>
                            <Grid ColumnDefinitions="130,*,8,130" RowDefinitions="Auto">
                                <TextBlock Classes="label" Text="Интенсивность λ"/>
                                <TextBox x:Name="LambdaBox" Grid.Column="1" Text="2"/>
                                <ComboBox x:Name="LambdaUnit" Grid.Column="3" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Grid.Column="2">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="cardTitle" Text="Поток обслуживания"/>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="ByMu" GroupName="svc" Content="интенсивность μ" IsChecked="True"/>
                                <RadioButton x:Name="ByTime" GroupName="svc" Content="время обслуживания t̄об"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="130,*,8,130">
                                <TextBlock x:Name="ServiceLabel" Classes="label" Text="Интенсивность μ"/>
                                <TextBox x:Name="ServiceBox" Grid.Column="1" Text="3"/>
                                <ComboBox x:Name="ServiceUnit" Grid.Column="3" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="card">
                    <WrapPanel ItemSpacing="24" LineSpacing="10">
                        <StackPanel x:Name="ChannelsPanel" Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="label" Text="Число каналов n"/>
                            <NumericUpDown x:Name="ChannelsBox" Minimum="1" Maximum="200" Increment="1"
                                           Value="2" FormatString="0" Width="130"/>
                        </StackPanel>
                        <StackPanel x:Name="QueuePanel" Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="label" Text="Мест в очереди m"/>
                            <NumericUpDown x:Name="QueueBox" Minimum="1" Maximum="1000" Increment="1"
                                           Value="3" FormatString="0" Width="130"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="label" Text="Единица времени в результатах"/>
                            <ComboBox x:Name="OutputUnit" Width="110"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Рассчитать" Click="OnCalculate" Classes="accent" Padding="18,6"/>
                            <Button Content="Очистить" Click="OnReset" Padding="14,6"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Border x:Name="ErrorBorder" IsVisible="False" Background="#FDECEC" BorderBrush="#F3B4B4"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <TextBlock x:Name="ErrorText" Foreground="#A12626" TextWrapping="Wrap"/>
                </Border>

                <!-- 3. Характеристики эффективности -->
                <Border x:Name="ResultsCard" Classes="card" IsVisible="False">
                    <StackPanel>
                        <TextBlock Classes="cardTitle" Text="Характеристики эффективности"/>
                        <Grid x:Name="ResultsGrid" ColumnDefinitions="2.2*,0.7*,3*,1.3*"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StatesCard" Classes="card" IsVisible="False">
                    <StackPanel>
                        <TextBlock Classes="cardTitle" Text="Предельные вероятности состояний"/>
                        <TextBlock x:Name="StatesNote" Foreground="#666" FontSize="12" Margin="0,-4,0,8" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="StatesPanel" ItemSpacing="8" LineSpacing="8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
