<Window x:Class="QueueAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализ СМО — ПР №14"
        Width="1240" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}"
        FontFamily="Segoe UI" FontSize="14">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{x:Static ApplicationCommands.Find}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnCalculateCommand"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Плитка выбора типа СМО -->
        <Style x:Key="TypeTile" TargetType="RadioButton">
            <Setter Property="GroupName" Value="qs"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileKind" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="TileText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="8" Padding="0,9">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D97418"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="0,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 1. Меню -->
        <Menu DockPanel.Dock="Top" Background="White" Padding="4,2">
            <MenuItem Header="_Файл">
                <MenuItem Header="Рассчитать" InputGestureText="F5" Click="OnCalculate"/>
                <MenuItem Header="Очистить" Click="OnReset"/>
                <Separator/>
                <MenuItem Header="Выход" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Тип СМО">
                <MenuItem Header="Одноканальные">
                    <MenuItem Header="1. С отказами" Tag="0" Click="OnMenuType"/>
                    <MenuItem Header="2. С ограниченной очередью" Tag="1" Click="OnMenuType"/>
                    <MenuItem Header="3. С неограниченной очередью" Tag="2" Click="OnMenuType"/>
                </MenuItem>
                <MenuItem Header="Многоканальные">
                    <MenuItem Header="4. С отказами" Tag="3" Click="OnMenuType"/>
                    <MenuItem Header="5. С ограниченной очередью" Tag="4" Click="OnMenuType"/>
                    <MenuItem Header="6. С неограниченной очередью" Tag="5" Click="OnMenuType"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="АНАЛИЗ СИСТЕМ МАССОВОГО ОБСЛУЖИВАНИЯ" Foreground="#9FB0D0"
                           FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="TypeTitle" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBlock x:Name="TypeDescription" Foreground="#C9D3E6" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Плитки выбора типа -->
        <UniformGrid DockPanel.Dock="Top" Columns="6" Margin="18,12,18,0">
            <RadioButton x:Name="Type0" Style="{StaticResource TypeTile}" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="1" Style="{StaticResource TileNum}"/>
                    <StackPanel>
                        <TextBlock Text="ОДНОКАНАЛЬНАЯ" Style="{StaticResource TileKind}"/>
                        <TextBlock Text="с отказами" Style="{StaticResource TileText}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="Type1" Style="{StaticResource TypeTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="2" Style="{StaticResource TileNum}"/>
                    <StackPanel>
                        <TextBlock Text="ОДНОКАНАЛЬНАЯ" Style="{StaticResource TileKind}"/>
                        <TextBlock Text="огранич. очередь" Style="{StaticResource TileText}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="Type2" Style="{StaticResource TypeTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="3" Style="{StaticResource TileNum}"/>
                    <StackPanel>
                        <TextBlock Text="ОДНОКАНАЛЬНАЯ" Style="{StaticResource TileKind}"/>
                        <TextBlock Text="неогранич. очередь" Style="{StaticResource TileText}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="Type3" Style="{StaticResource TypeTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="4" Style="{StaticResource TileNum}"/>
                    <StackPanel>
                        <TextBlock Text="МНОГОКАНАЛЬНАЯ" Style="{StaticResource TileKind}"/>
                        <TextBlock Text="с отказами" Style="{StaticResource TileText}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="Type4" Style="{StaticResource TypeTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="5" Style="{StaticResource TileNum}"/>
                    <StackPanel>
                        <TextBlock Text="МНОГОКАНАЛЬНАЯ" Style="{StaticResource TileKind}"/>
                        <TextBlock Text="огранич. очередь" Style="{StaticResource TileText}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="Type5" Style="{StaticResource TypeTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="6" Style="{StaticResource TileNum}"/>
                    <StackPanel>
                        <TextBlock Text="МНОГОКАНАЛЬНАЯ" Style="{StaticResource TileKind}"/>
                        <TextBlock Text="неогранич. очередь" Style="{StaticResource TileText}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <Grid Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 2. Исходные данные -->
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Исходные данные" FontSize="17" FontWeight="SemiBold"/>

                        <TextBlock Text="ВХОДНОЙ ПОТОК" Style="{StaticResource Section}"/>
                        <TextBlock Text="Интенсивность λ" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LambdaBox" Text="2"/>
                            <ComboBox x:Name="LambdaUnit" Grid.Column="2"/>
                        </Grid>

                        <TextBlock Text="ПОТОК ОБСЛУЖИВАНИЯ" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="ByMu" GroupName="svc" Content="μ" IsChecked="True" Margin="0,0,18,0"/>
                            <RadioButton x:Name="ByTime" GroupName="svc" Content="время tоб"/>
                        </StackPanel>
                        <TextBlock x:Name="ServiceLabel" Text="Интенсивность μ" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServiceBox" Text="3"/>
                            <ComboBox x:Name="ServiceUnit" Grid.Column="2"/>
                        </Grid>

                        <StackPanel x:Name="SystemPanel">
                            <TextBlock Text="ПАРАМЕТРЫ СИСТЕМЫ" Style="{StaticResource Section}"/>
                            <StackPanel x:Name="ChannelsPanel" Margin="0,0,0,8">
                                <TextBlock Text="Число каналов n" Margin="0,0,0,4"/>
                                <TextBox x:Name="ChannelsBox" Text="2"/>
                            </StackPanel>
                            <StackPanel x:Name="QueuePanel">
                                <TextBlock Text="Мест в очереди m" Margin="0,0,0,4"/>
                                <TextBox x:Name="QueueBox" Text="3"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="РЕЗУЛЬТАТЫ" Style="{StaticResource Section}"/>
                        <TextBlock Text="Единица времени" Margin="0,0,0,4"/>
                        <ComboBox x:Name="OutputUnit"/>

                        <Border x:Name="ErrorBorder" Visibility="Collapsed" Background="#FDECEC"
                                BorderBrush="#F3B4B4" BorderThickness="1" CornerRadius="8"
                                Padding="10" Margin="0,14,0,0">
                            <TextBlock x:Name="ErrorText" Foreground="#A12626" TextWrapping="Wrap"/>
                        </Border>

                        <Button Content="Рассчитать  (F5)" Style="{StaticResource PrimaryButton}"
                                Margin="0,18,0,8" Click="OnCalculate" IsDefault="True"/>
                        <Button Content="Очистить" Style="{StaticResource GhostButton}" Click="OnReset"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 3. Результаты -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Foreground="{StaticResource Muted}"
                               Text="Введите исходные данные и нажмите «Рассчитать»"/>

                    <TabControl x:Name="ResultTabs" Visibility="Collapsed" BorderThickness="0" Margin="10">
                        <TabItem Header="Характеристики эффективности" Padding="12,6">
                            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EEF0F4" BorderThickness="0"
                                      Background="White" RowBackground="White"
                                      AlternatingRowBackground="#FAFBFC" CanUserAddRows="False"
                                      CanUserResizeRows="False" SelectionMode="Single" Margin="0,8,0,0">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F0F2F6"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Характеристика" Binding="{Binding Name}" Width="2.2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Обозн." Binding="{Binding Symbol}" Width="0.7*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#1E2A44"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Формула" Binding="{Binding Formula}" Width="3*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Foreground" Value="#4B5563"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Значение" Binding="{Binding ValueText}" Width="1.3*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Вероятности состояний" Padding="12,6">
                            <DockPanel Margin="4,10,4,4">
                                <TextBlock x:Name="StatesNote" DockPanel.Dock="Top" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="StatesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="#EEF0F4" CornerRadius="4" Height="18">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Filled}"/>
                                                                <ColumnDefinition Width="{Binding Rest}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{StaticResource Accent}" CornerRadius="4"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontFamily="Consolas"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
